PORT=3000
NODE_ENV=development

SESSION_SECRET=replace_this_with_a_long_random_string

DB_HOST=localhost
DB_PORT=3306
DB_NAME=survey_system
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_DIALECT=mysql

DB_POOL_MAX=5

DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA=

# Optional: a single MySQL connection string. When set it overrides the DB_* values above.
# Most hosted MySQL providers (Aiven, TiDB Cloud, Railway) give you a URL in this format.
# DATABASE_URL=mysql://user:password@host:3306/survey_system
