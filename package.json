{
  "name": "survey-sphere",
  "version": "1.0.0",
  "description": "Survey Sphere - an online survey system built with Node.js, Express, EJS, Sequelize and MySQL",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "seed": "sequelize-cli db:seed:all",
    "seed:undo": "sequelize-cli db:seed:undo:all",
    "db:setup": "npm run migrate && npm run seed",
    "build": "npm run migrate"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "survey",
    "express",
    "mysql",
    "sequelize",
    "ejs"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-flash": "^0.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.19.0",
    "joi": "^18.2.3",
    "method-override": "^3.0.0",
    "mysql2": "^3.23.2",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
