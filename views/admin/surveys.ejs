<div class="d-flex justify-content-between align-items-center mb-4">
  <h3 class="mb-0">Surveys</h3>
  <a class="btn btn-outline-secondary" href="/admin">Admin Dashboard</a>
</div>

<div class="card">
  <div class="card-body">
    <p class="text-muted"><%= totalSurveys %> survey<%= totalSurveys === 1 ? '' : 's' %> on the system</p>

    <table class="table align-middle mb-0">
      <thead>
        <tr>
          <th>Title</th>
          <th>Owner</th>
          <th>Status</th>
          <th>Responses</th>
          <th>Created</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% surveys.forEach((survey) => { %>
          <tr>
            <td><%= survey.title %></td>
            <td>
              <%= survey.owner.name %>
              <div class="small text-muted"><%= survey.owner.email %></div>
            </td>
            <td><%- include('../partials/statusBadge', { status: survey.status }) %></td>
            <td><%= survey.get('responseCount') %></td>
            <td><%= survey.createdAt.toLocaleDateString() %></td>
            <td class="text-end">
              <form class="d-inline" method="post" action="/admin/surveys/<%= survey.id %>?_method=DELETE"
                    onsubmit="return confirm('Delete this survey and every response it collected?');">
                <button class="btn btn-sm btn-outline-danger" type="submit">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<div class="mt-3">
  <%- include('../partials/pagination', { page, totalPages, baseUrl: '/admin/surveys' }) %>
</div>
