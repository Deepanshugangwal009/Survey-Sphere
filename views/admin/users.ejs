<div class="d-flex justify-content-between align-items-center mb-4">
  <h3 class="mb-0">Users</h3>
  <a class="btn btn-outline-secondary" href="/admin">Admin Dashboard</a>
</div>

<div class="card">
  <div class="card-body">
    <p class="text-muted"><%= totalUsers %> registered user<%= totalUsers === 1 ? '' : 's' %></p>

    <table class="table align-middle mb-0">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Role</th>
          <th>Surveys</th>
          <th>Joined</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach((user) => { %>
          <tr>
            <td><%= user.name %></td>
            <td><%= user.email %></td>
            <td>
              <span class="badge bg-<%= user.role === 'admin' ? 'dark' : 'light text-dark' %>">
                <%= user.role %>
              </span>
            </td>
            <td><%= user.get('surveyCount') %></td>
            <td><%= user.createdAt.toLocaleDateString() %></td>
            <td class="text-end">
              <% if (user.id === currentUser.id) { %>
                <span class="text-muted small">You</span>
              <% } else { %>
                <form class="d-inline" method="post" action="/admin/users/<%= user.id %>?_method=DELETE"
                      onsubmit="return confirm('Delete this user and every survey they created?');">
                  <button class="btn btn-sm btn-outline-danger" type="submit">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<div class="mt-3">
  <%- include('../partials/pagination', { page, totalPages, baseUrl: '/admin/users' }) %>
</div>
