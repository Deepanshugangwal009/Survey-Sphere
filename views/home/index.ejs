<div class="p-5 mb-4 bg-white rounded-3 shadow-sm text-center">
  <h1 class="display-5">Create Surveys. Collect Answers. See Results.</h1>
  <p class="lead text-muted">
    A simple online survey system where you can build your own surveys, share them with a link,
    and watch the responses turn into charts.
  </p>
  <a class="btn btn-primary btn-lg" href="/register">Get Started</a>
  <a class="btn btn-outline-secondary btn-lg" href="/login">Login</a>
</div>

<div class="row">
  <div class="col-md-4 mb-3">
    <div class="card h-100">
      <div class="card-body">
        <h5 class="card-title"><i class="fa-solid fa-pen-to-square text-primary me-2"></i>Build</h5>
        <p class="card-text">
          Add single choice, multiple choice, short text and rating questions to your survey.
        </p>
      </div>
    </div>
  </div>
  <div class="col-md-4 mb-3">
    <div class="card h-100">
      <div class="card-body">
        <h5 class="card-title"><i class="fa-solid fa-share-nodes text-primary me-2"></i>Share</h5>
        <p class="card-text">
          Publish a survey to get a public link that anyone can open and answer without an account.
        </p>
      </div>
    </div>
  </div>
  <div class="col-md-4 mb-3">
    <div class="card h-100">
      <div class="card-body">
        <h5 class="card-title"><i class="fa-solid fa-chart-pie text-primary me-2"></i>Analyse</h5>
        <p class="card-text">
          See how many people answered, what they picked, and the average of every rating question.
        </p>
      </div>
    </div>
  </div>
</div>
