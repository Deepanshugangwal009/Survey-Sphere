<%
  const flashGroups = [
    { messages: locals.success, style: 'success', icon: 'fa-circle-check' },
    { messages: locals.error, style: 'danger', icon: 'fa-circle-exclamation' }
  ];
%>

<% flashGroups.forEach((group) => { %>
  <% (group.messages || []).forEach((message) => { %>
    <div class="alert alert-<%= group.style %> alert-dismissible fade show" role="alert">
      <i class="fa-solid <%= group.icon %> me-1"></i><%= message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% }); %>
<% }); %>
