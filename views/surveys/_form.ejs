<div class="mb-3">
  <label class="form-label" for="title">Title</label>
  <input class="form-control" type="text" id="title" name="title" value="<%= values.title || '' %>" required>
</div>
<div class="mb-3">
  <label class="form-label" for="description">Description</label>
  <textarea class="form-control" id="description" name="description" rows="4"><%= values.description || '' %></textarea>
</div>
<button class="btn btn-primary" type="submit"><%= submitLabel %></button>
<a class="btn btn-outline-secondary" href="<%= cancelUrl %>">Cancel</a>
